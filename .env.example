# Supabase — projet "Opalook" (Decupler Org, eu-west-3)
NEXT_PUBLIC_SUPABASE_URL=https://pjxvstskgzvsyzkbxxug.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL publique de l'app, utilisée pour le lien magique d'authentification.
# En local : http://localhost:3000 — sur Vercel : laisser vide (déduit automatiquement).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rédaction des textes de catégorie. Serveur uniquement, jamais exposée au client.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Analyse de SERP. Identifiants du compte DataForSEO (authentification Basic).
# Chaque analyse est facturée : l'app archive le résultat plutôt que de réinterroger.
#
# Deux façons de s'authentifier, au choix. DataForSEO affiche dans son tableau
# de bord une chaîne déjà encodée — base64 de « login:password » — que l'on peut
# coller telle quelle ici ; elle a la priorité. Sinon, renseigner le couple.
DATAFORSEO_BASE64=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Laissez-passer pour franchir le pare-feu applicatif du site à analyser.
# Cloudflare refuse les requêtes serveur en 403 : il faut une règle WAF qui
# laisse passer celles portant cet en-tête. Plus fiable qu'une liste d'IP,
# celles de Vercel étant mouvantes.
EXTRACT_BYPASS_HEADER=x-opalook-bypass
EXTRACT_BYPASS_TOKEN=

# Récupération des pages protégées par un pare-feu applicatif.
# Premier repli quand la requête directe est refusée : rendu navigateur et
# proxies résidentiels. https://firecrawl.dev
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxx
